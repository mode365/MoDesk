+// syntheticInterfaces mirrors feature/androidbin's buildSynthetic: a single
+// made-up interface carrying the process's outbound IPv4/IPv6 source
+// addresses, discovered by opening (never sending on) UDP sockets.
+func syntheticInterfaces() ([]netmon.Interface, error) {
+	var addrs []net.Addr
+	if ip, ok := outboundIP("udp4", "8.8.8.8:53"); ok {
+		addrs = append(addrs, &net.IPNet{IP: ip.AsSlice(), Mask: net.CIDRMask(32, 32)})
+	}
+	if ip, ok := outboundIP("udp6", "[2001:4860:4860::8888]:53"); ok {
+		addrs = append(addrs, &net.IPNet{IP: ip.AsSlice(), Mask: net.CIDRMask(128, 128)})
+	}
+	if len(addrs) == 0 {
+		return nil, errors.New("libtailcat: no outbound routes found")
+	}
+	return []netmon.Interface{{
+		Interface: &net.Interface{
+			MTU:   1500,
+			Name:  "android",
+			Flags: net.FlagUp | net.FlagRunning,
+		},
+		AltAddrs: addrs,
+	}}, nil
+}
+
+// outboundIP reports the local source address the kernel picks for an
+// outbound socket to addr. Dialing UDP performs no I/O, so this works under
+// Android's app sandbox where interface enumeration does not.
+func outboundIP(network, addr string) (netip.Addr, bool) {
+	d := net.Dialer{Timeout: 2 * time.Second}
+	c, err := d.Dial(network, addr)
+	if err != nil {
+		return netip.Addr{}, false
+	}
+	defer c.Close()
+	ua, ok := c.LocalAddr().(*net.UDPAddr)
+	if !ok {
+		return netip.Addr{}, false
+	}
+	ip, ok := netip.AddrFromSlice(ua.IP)
+	if !ok {
+		return netip.Addr{}, false
+	}
+	ip = ip.Unmap()
+	if ip.IsLoopback() || ip.IsUnspecified() {
+		return netip.Addr{}, false
+	}
+	return ip, true
+}
+
+// logfFor returns a logger writing to path (one timestamped line per call),
+// or logger.Discard when path is empty or cannot be opened. Upstream tailcat
+// discards all internal logs; this diagnostic patch makes the internals
+// (netcheck, disco, magicsock) observable from the embedding app.
+func logfFor(path string) logger.Logf {
+	if path == "" {
+		return logger.Discard
+	}
+	w, err := os.OpenFile(path, os.O_CREATE|os.O_APPEND|os.O_WRONLY, 0o644)
+	if err != nil {
+		return logger.Discard
+	}
+	logf := func(format string, args ...any) {
+		fmt.Fprintf(w, time.Now().UTC().Format("2006-01-02T15:04:05.000Z07:00")+" "+format+"\n", args...)
+	}
+	logf("tailcat diag logging enabled (patched build)")
+	return logf
+}
