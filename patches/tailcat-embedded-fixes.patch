+// Android netmon fallback -- diagnostic/local patch, not in upstream tailcat.
+//
+// libtailcat is a GOOS=android cgo c-shared build, and that combination is
+// exactly the one tailcat's own feature/androidbin package excludes from
+// compilation (feature/androidbin/register.go builds only on
+// (linux && !android) || (android && !cgo): official Android apps register a
+// Java-backed interface getter instead). Embedded via dlopen we have no
+// Java, so nothing registers HookInterfacesFallback, and Android app UIDs
+// cannot open NETLINK_ROUTE sockets, so net.Interfaces() fails with
+// "route ip+net: netlinkrib: permission denied" on every call. Every
+// magicsock endpoint update died there, netcheck always reported udp=false,
+// no local or STUN endpoints were ever collected, and P2P was impossible --
+// mesh sessions could only ride the DERP relay. Register tailcat's own
+// synthetic-interface fallback (asking the kernel to route UDP sockets,
+// which needs no privileges) the way androidbin would have. Windows and
+// Linux are untouched: the hook runs only when net.Interfaces already
+// failed, which does not happen there.
+func init() {
+	if runtime.GOOS == "android" && feature.Register("libtailcat-android-netmon") {
+		netmon.HookInterfacesFallback.Set(syntheticInterfaces)
+	}
+}
